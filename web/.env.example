# Public Supabase credentials for the Three Headlines and a Lie frontend.
# Both values are safe to expose in client-side code — they are the
# publishable/anon key, not the secret service-role key.
#
# Copy this file to .env.local and fill in your project values.
# Never commit .env.local or any file containing real credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
